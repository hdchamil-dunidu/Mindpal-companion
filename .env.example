# Server only. Never put these values into web/ or the Android project.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=
MONGODB_DB=mindpal
# Use the exact newly rotated URI from your Azure portal, with required TLS options.
# For Cosmos MongoDB RU accounts use retryWrites=false unless enabled on the account.
GEMINI_API_KEY=
GEMINI_MODEL=auto
SESSION_SECRET=
# Comma separated exact origins, no trailing slash. Add your actual HTTPS domain.
ALLOWED_ORIGINS=https://appassets.androidplatform.net,http://localhost:3000,http://127.0.0.1:3000

# Optional PUBLIC HTTPS backend origin bundled into Android (never a secret).
MINDPAL_PUBLIC_SERVER_URL=

# Google OAuth web application credentials (backend only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact URL registered in Google Cloud, e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=
